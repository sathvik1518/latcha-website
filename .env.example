# Neon: copy the POOLED connection string from the Neon dashboard (host contains "-pooler")
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Website addresses allowed to call this API, comma separated, no trailing slash
CORS_ORIGINS=https://YOUR-SITE.vercel.app,http://localhost:8000
ADMIN_USERNAME=owner
# Make with: python scripts/make_admin_hash.py
ADMIN_PASSWORD_HASH=
# Make with: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=

# UPI payments: demo (pretend pay screen, no money), razorpay (real checkout) or off
PAYMENTS_MODE=demo
# Only for PAYMENTS_MODE=razorpay. Start with TEST keys (rzp_test_...). Never put these in chat or in git.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Make up a long random text; use the same text in the Razorpay dashboard webhook
RAZORPAY_WEBHOOK_SECRET=
