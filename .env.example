# Neon: copy the POOLED connection string from the Neon dashboard (host contains "-pooler")
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Website addresses allowed to call this API, comma separated, no trailing slash
CORS_ORIGINS=https://YOUR-SITE.vercel.app,http://localhost:8000
ADMIN_USERNAME=owner
# Make with: python scripts/make_admin_hash.py
ADMIN_PASSWORD_HASH=
# Make with: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
